# Fresh-checkout offline defaults: scripted model decisions and local file storage.
WORKSHOP_MODE=test
WORKSHOP_STORE=local
# Direct Google runs: use a private Google AI Studio key; no Gateway fallback.
# WORKSHOP_MODE=live
# GOOGLE_GENERATIVE_AI_API_KEY=
# WORKSHOP_MODEL=gemini-3.8-flash
# Each user-triggered live run incurs Google API usage; repeated testing is enabled.
# Historical Gateway key, if present, is preserved but unused by the active provider.
# AI_GATEWAY_API_KEY=
# Optional Postgres storage works independently of test/live model mode.
# This workspace uses a dedicated Neon database with db/schema.sql already applied.
# For another database, apply db/schema.sql explicitly before using its private URL.
# WORKSHOP_STORE=postgres
# DATABASE_URL=
# Hosted live runs on Vercel also require this explicit opt-in and Postgres above.
# WORKSHOP_ALLOW_HOSTED_LIVE=true
# Shared daily allowance for live preparation starts and reruns (UTC).
# Apply db/daily-generation-allowance.sql to an existing Postgres database first.
# Unset keeps the current behavior until rollout; 0 pauses new preparations.
# WORKSHOP_DAILY_GENERATION_LIMIT=20
