# Offline defaults: scripted model decisions and local file storage.
WORKSHOP_MODE=test
WORKSHOP_STORE=local

# Optional live mode. Keep your actual key in an untracked .env.local.
# WORKSHOP_MODE=live
# GOOGLE_GENERATIVE_AI_API_KEY=
# Current supported model is defined in lib/config.ts.
# WORKSHOP_MODEL=gemini-3.8-flash

# Optional Postgres: explicitly apply db/schema.sql to your own database first.
# WORKSHOP_STORE=postgres
# DATABASE_URL=

# Vercel live generation requires Postgres and this explicit opt-in.
# WORKSHOP_ALLOW_HOSTED_LIVE=true

# Shared UTC daily preparation-start limit (includes reruns).
# Existing databases need db/daily-generation-allowance.sql before activation.
# Unset disables this allowance; 0 pauses new starts.
# WORKSHOP_DAILY_GENERATION_LIMIT=20
